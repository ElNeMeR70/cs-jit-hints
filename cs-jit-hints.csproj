<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <AssemblyName>cs-jit-hints</AssemblyName>
    <RootNamespace>jit_hints</RootNamespace>
    <Description>JIT optimization hints: AggressiveInlining, NoInlining, loops</Description>
    <Authors>Mahmoud ElNemer</Authors>
    <PackageProjectUrl>https://github.com/ElNeMeR70/cs-jit-hints</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ElNeMeR70/cs-jit-hints</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
</Project>
